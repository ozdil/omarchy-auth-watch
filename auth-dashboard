#!/usr/bin/env bash
DIR="$(cd "$(dirname "$(realpath "$0")")" >/dev/null 2>&1 && pwd)"
clear
echo -e "\033[1;36m=================================================================\033[0m"
echo -e "\033[1;33m  🚨 AUTH WATCH • PAM, Sudo & SSH Giriş Denemeleri Denetçisi \033[0m"
echo -e "\033[1;36m=================================================================\033[0m"
echo ""

DATA=$("$DIR/auth-scanner" 2>/dev/null || echo '{"status":"UNKNOWN","events":[]}')

python3 -c "
import json, sys

try:
    d = json.loads('''$DATA''')
    status = d.get('status', 'UNKNOWN')
    failed = d.get('failed_attempts', 0)
    events = d.get('events', [])

    print(f'📊 Durum: {status} | Son 24 Saat Hatalı Giriş: {failed}\n')
    if events:
        print('Son Başarısız Giriş Kayıtları:')
        print('-' * 65)
        for ev in events:
            print(f'• {ev}')
    else:
        if status == 'SECURE':
            print('✓ Son 24 saatte başarısız yetkilendirme denemesi kaydedilmedi.')
        else:
            print(f'⚠️ Log okunamadı: {d.get(\"error\", \"Bilinmeyen hata\")}')
except Exception as e:
    print(f'Hata: {e}')
"

echo ""
echo -e "\033[0;90mKapatmak için bir tuşa basın...\033[0m"
read -n 1 -s -r
