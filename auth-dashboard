#!/usr/bin/env python3
import os
import sys
import subprocess
import json

def main():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    scanner_path = os.path.join(plugin_dir, "auth-scanner")

    os.system("clear")
    print("\033[1;36m=================================================================\033[0m")
    print("\033[1;33m  🚨 AUTH WATCH • Kimlik Doğrulama & Giriş Denetçisi \033[0m")
    print("\033[1;36m=================================================================\033[0m\n")

    try:
        res = subprocess.run([scanner_path], capture_output=True, text=True, timeout=2.0)
        data = json.loads(res.stdout) if res.returncode == 0 else {}
    except Exception as e:
        data = {"status": "UNKNOWN", "error": str(e)}

    status = data.get("status", "UNKNOWN")
    failed = data.get("failed_events_count", 0)
    scope = data.get("readable_scope", "Bilinmiyor")
    events = data.get("events", [])

    print(f"📊 Durum: {status} | Son 24 Saat Hatalı Giriş: {failed} | Kapsam: {scope}\n")
    print("SON ŞÜPHELİ / HATALI GİRİŞ GÜNLÜKLERİ:")
    print("-" * 65)

    if events:
        for ev in events:
            print(f"⚠️  {ev.get('raw_event', '')}")
    else:
        print("✓ Son 24 saat içinde şüpheli hatalı giriş kaydı tespit edilmedi.")

    print("\n\033[0;90mKapatmak için Enter'a basın...\033[0m")
    try:
        input()
    except (EOFError, KeyboardInterrupt):
        pass

if __name__ == "__main__":
    main()
