#!/usr/bin/env python3
import subprocess
import json
import re
import sys

def sanitize_str(s, max_len=80):
    return re.sub(r'[\x00-\x1f\x7f-\x9f]', '', str(s))[:max_len]

def scan_auth_journal():
    try:
        # Structured query for auth events in last 24h, bounded to max 100 entries
        res = subprocess.run(
            ["journalctl", "-u", "systemd-logind", "-u", "sshd", "-g", "Failed|invalid|sudo", "--since", "24 hours ago", "-n", "100", "--no-pager", "-o", "cat"],
            capture_output=True,
            text=True,
            timeout=2.5,
            check=False
        )
        if res.returncode != 0:
            return {
                "status": "UNKNOWN",
                "status_color": "#f59e0b",
                "failed_attempts": 0,
                "error": "journalctl okunamadı (yetki/servis hatası)",
                "events": []
            }

        lines = res.stdout.strip().splitlines()
        failed_events = []

        for line in lines:
            clean_line = sanitize_str(line, 75)
            if any(k in clean_line.lower() for k in ("failed password", "authentication failure", "incorrect password", "invalid user", "pam_unix")):
                failed_events.append(clean_line)

        failed_count = len(failed_events)
        status = "SECURE" if failed_count == 0 else "WARNING"
        status_color = "#00cbb8" if failed_count == 0 else "#ef4444"

        return {
            "status": status,
            "status_color": status_color,
            "failed_attempts": failed_count,
            "events": failed_events[:15]
        }
    except Exception as e:
        return {
            "status": "UNKNOWN",
            "status_color": "#f59e0b",
            "failed_attempts": 0,
            "error": sanitize_str(str(e), 60),
            "events": []
        }

if __name__ == "__main__":
    print(json.dumps(scan_auth_journal()))
