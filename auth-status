#!/usr/bin/env bash
set -eo pipefail
DIR="$(cd "$(dirname "$(realpath "$0")")" >/dev/null 2>&1 && pwd)"
SCAN_OUT="$("$DIR/auth-scanner" 2>/dev/null || echo '{"status":"UNKNOWN","failed_attempts":0}')"

python3 -c "
import json, sys

try:
    d = json.loads('''$SCAN_OUT''')
    status = d.get('status', 'UNKNOWN')
    failed = d.get('failed_attempts', 0)

    if status == 'SECURE':
        text = '󰌾 Auth: Güvenli'
        css = 'normal'
    elif status == 'WARNING':
        text = f'🚨 {failed} Başarısız Giriş!'
        css = 'alert'
    else:
        text = '󰌾 Auth: Bilinmiyor'
        css = 'alert'

    tooltip = f'🚨 Auth Log Auditor\n• Durum: {status}\n• Son 24s Hatalı Giriş: {failed}\n\n[Sol Tık] Giriş Loglarını İncele'
    print(json.dumps({'text': text, 'tooltip': tooltip, 'class': css}))
except Exception:
    print(json.dumps({'text': '󰌾 Auth: Hata', 'tooltip': 'Hata: Auth verisi alınamadı', 'class': 'alert'}))
"
