#!/usr/bin/env bash
python3 -c "
import subprocess, json
try:
    res = subprocess.run(['/home/ozdil/.config/omarchy/plugins/auth-watch/auth-scanner'], capture_output=True, text=True, timeout=3)
    data = json.loads(res.stdout)
    fails = data.get('total_failures', 0)
    sudo_f = data.get('failed_sudo_count', 0)
    ssh_f = data.get('failed_ssh_count', 0)
except Exception:
    fails, sudo_f, ssh_f = 0, 0, 0

icon = '󰌾' if fails == 0 else '🚨'
text = f'{icon} Auth 0' if fails == 0 else f'{icon} Auth {fails}!'
tooltip = f'🚨 Auth Watch • Oturum & Yetki Nöbetçisi\n• Son 24s Başarısız Giriş: {fails}\n• Sudo Başarısız: {sudo_f}\n• SSH Başarısız: {ssh_f}\n\n[Sol Tık] Güvenlik Loglarını İncele'

print(json.dumps({
    'text': text,
    'tooltip': tooltip,
    'class': 'alert' if fails > 0 else 'active'
}))
"
