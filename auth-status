#!/usr/bin/env python3
import subprocess
import json
import os
import sys

def main():
    plugin_dir = os.path.dirname(os.path.realpath(__file__))
    scanner_path = os.path.join(plugin_dir, "auth-scanner")

    try:
        res = subprocess.run([scanner_path], capture_output=True, text=True, timeout=2.0)
        data = json.loads(res.stdout) if res.returncode == 0 else {}
    except Exception:
        data = {}

    status = data.get("status", "UNKNOWN")
    failed = data.get("failed_events_count", 0)

    if status == "NORMAL":
        text = "󰌾 Auth: Temiz"
        css = "normal"
    elif status == "ALERT":
        text = f"󰌿 {failed} Hatalı Giriş!"
        css = "alert"
    else:
        text = "󰌾 Auth: Bilinmiyor"
        css = "alert"

    tooltip = f"🚨 Auth Watch • Kimlik Doğrulama Denetçisi\n• Durum: {status}\n• Hatalı Giriş Sayısı: {failed}\n• Kapsam: {data.get('readable_scope', 'Kullanıcı Günlüğü')}\n\n[Sol Tık] Olay Günlüğünü Aç"
    print(json.dumps({"text": text, "tooltip": tooltip, "class": css}))

if __name__ == "__main__":
    main()
